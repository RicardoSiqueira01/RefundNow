        <name>Validates Date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

   var today = new Date();
   today.setHours(0,0,0,0);

   var selectedDate = new Date(newValue);
   selectedDate.setHours(0,0,0,0);

   var minDate = new Date(today);
   minDate.setDate(today.getDate() - 30); 

   if (isNaN(selectedDate)) {
      g_form.addErrorMessage('Please, select a valid date!');
      g_form.setValue('payment_date', '');
      return;
   }

   if (selectedDate > today) {
      g_form.addErrorMessage('Future dates are not allowed');
      g_form.setValue('payment_date', '');
      return;
   }

   if (selectedDate < minDate) {
      g_form.addErrorMessage('Date cannot be more than 30 days in the past');
      g_form.setValue('payment_date', '');
      return;
   }
}
]]></script>
